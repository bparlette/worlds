{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "fog": {
      "type": "string"
    },
    "game": {
      "type": "string"
    },
    "ground": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "parts": {
      "items": {
        "properties": {
          "a": {
            "enum": [
              "none",
              "bob",
              "spin",
              "sway",
              "pulse"
            ],
            "type": "string"
          },
          "ap": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "c": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "e": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "n": {
            "maximum": 64,
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "p": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "r": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "role": {
            "enum": [
              "prop",
              "wall"
            ],
            "type": "string"
          },
          "rx": {
            "type": "number"
          },
          "ry": {
            "type": "number"
          },
          "rz": {
            "type": "number"
          },
          "s": {
            "enum": [
              "box",
              "cyl",
              "sph",
              "cone",
              "tor",
              "wed",
              "gnd"
            ],
            "type": "string"
          },
          "z": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          }
        },
        "required": [
          "s",
          "p",
          "z",
          "c"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "sky": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "game",
    "parts"
  ],
  "type": "object"
}
